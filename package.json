    "react-dom": "19.1.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "7.7.1",
    "uuid": "11.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@testing-library/jest-dom": "^6.9.1",
